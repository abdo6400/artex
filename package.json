{
  "name": "artex-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @artex/web dev",
    "dev:platform": "pnpm --filter @artex/web dev",
    "db:check": "pnpm --filter @artex/database db:check",
    "db:generate": "pnpm --filter @artex/database db:generate",
    "db:migrate": "pnpm --filter @artex/database db:migrate",
    "db:seed-owner": "pnpm --filter @artex/database db:seed-owner",
    "db:seed-site": "pnpm --filter @artex/database db:seed-site",
    "db:recover-account": "pnpm --filter @artex/database db:recover-account",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "smoke:api": "pnpm --filter @artex/web smoke",
    "check": "pnpm format:check && pnpm boundaries && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "turbo": "2.11.2",
    "typescript": "^6.0.3"
  }
}
