NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000/dashboard
API_INTERNAL_URL=http://localhost:3000
DATABASE_URL=postgresql://artex:artex@localhost:5432/artex
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-a-64-character-random-hex-key
REQUIRE_OWNER_MFA=false
MEDIA_STORAGE_PATH=.local-media
MEDIA_STORAGE_DRIVER=filesystem
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/api/v1/public/media
# Vercel: connect Blob, set MEDIA_STORAGE_DRIVER=vercel-blob, and use the
# BLOB_READ_WRITE_TOKEN injected by the integration.
OWNER_EMAIL=owner@example.com
OWNER_NAME=Artex Owner
OWNER_PASSWORD=replace-with-a-strong-password
WEB_ORIGIN=http://localhost:3000
DASHBOARD_ORIGIN=http://localhost:3000
